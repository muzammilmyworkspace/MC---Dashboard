// MC Nexus — Mission Control · Prisma schema (Phase 2)
// Target: PostgreSQL. Run `docker compose up -d` then `npm run setup`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ------------------------------- Enums -------------------------------- */

/** Two roles only — finer-grained permissions are handled in code. */
enum Role {
  TEAM
  CLIENT
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  YOUTUBE
}

enum ContentStatus {
  DRAFT
  INTERNAL_REVIEW
  CLIENT_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
}

enum PostType {
  IMAGE
  CAROUSEL
}

enum ReviewStatus {
  APPROVED
  CHANGES
  REJECTED
  COMMENT
}

enum MediaKind {
  POST
  REEL
}

enum IntegrationStatus {
  CONNECTED
  NOT_CONNECTED
  ERROR
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum NotificationTone {
  SUCCESS
  WARNING
  DANGER
  INFO
  ACCENT
}

/* ------------------------------- Identity ------------------------------ */

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(TEAM)
  title        String?
  avatarColor  String    @default("#2456d6")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]
  reviews       Review[]
  createdPlans  DayPlan[]      @relation("PlanCreator")
  notifications Notification[]
  auditLogs     AuditLog[]
  assignedTasks Task[]         @relation("TaskAssignee")
  createdTasks  Task[]         @relation("TaskCreator")

  @@index([role])
  landingPages LandingPage[]
}

/* -------------------------------- Tasks -------------------------------- */

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String       @default("")
  category       String
  /** Sidebar list the task is filed under: muzammil | hashaam | future */
  section        String
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(NOT_STARTED)
  dueDate        DateTime?    @db.Date
  estimatedHours Float?
  notes          String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  checklist   TaskChecklistItem[]
  attachments TaskAttachment[]

  @@index([section])
  @@index([assigneeId])
  @@index([status])
}

model TaskChecklistItem {
  id     String  @id @default(cuid())
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text   String
  done   Boolean @default(false)
  order  Int     @default(0)

  @@index([taskId])
}

model TaskAttachment {
  id       String  @id @default(cuid())
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name     String
  url      String?
  mimeType String?
  size     Int?

  @@index([taskId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/* ------------------------------- Content ------------------------------- */

model DayPlan {
  id              String        @id @default(cuid())
  date            DateTime      @unique @db.Date
  goal            String
  purpose         String
  primaryPlatform Platform
  postingTime     String // "18:00" (Europe/Amsterdam)
  status          ContentStatus @default(DRAFT)
  gradient        String
  emoji           String
  cta             String
  captionNl       String        @default("")
  hashtags        String[]
  storyIdeas      String[]
  createdById     String?
  createdBy       User?         @relation("PlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  captions Caption[]
  reel     Reel?
  post     ContentPost?
  reviews  Review[]
  media    MediaAsset[]

  @@index([status])
  @@index([date])
}

model Caption {
  id        String   @id @default(cuid())
  dayPlanId String
  dayPlan   DayPlan  @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  platform  Platform
  text      String

  @@unique([dayPlanId, platform])
}

model Reel {
  id                String  @id @default(cuid())
  dayPlanId         String  @unique
  dayPlan           DayPlan @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  topic             String
  hook              String
  script            String
  bRoll             String[]
  closingCta        String
  thumbnailConcept  String
  editorNotes       String
}

model ContentPost {
  id                    String   @id @default(cuid())
  dayPlanId             String   @unique
  dayPlan               DayPlan  @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  type                  PostType
  topic                 String
  imageConcept          String
  photographyDirection  String
  graphicText           String
  designerNotes         String
  slides                Int?
}

model Review {
  id        String       @id @default(cuid())
  dayPlanId String
  dayPlan   DayPlan      @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status    ReviewStatus
  comment   String       @default("")
  createdAt DateTime     @default(now())

  @@index([dayPlanId])
}

model MediaAsset {
  id        String    @id @default(cuid())
  dayPlanId String
  dayPlan   DayPlan   @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  kind      MediaKind
  url       String
  provider  String    @default("cloudinary")
  publicId  String?
  bytes     Int?
  createdAt DateTime  @default(now())

  @@index([dayPlanId])
}

/* ---------------------------- Integrations ----------------------------- */

model Integration {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  category    String
  status      IntegrationStatus @default(NOT_CONNECTED)
  health      HealthStatus      @default(UNKNOWN)
  lastSyncAt  DateTime?
  scopes      String[]
  // Encrypted/opaque credential blob — never returned to the client.
  credentials Json?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  syncRuns SyncRun[]
}

model SyncRun {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  startedAt     DateTime    @default(now())
  finishedAt    DateTime?
  success       Boolean     @default(false)
  recordCount   Int         @default(0)
  error         String?

  @@index([integrationId])
}

/* ------------------------------ Instagram ------------------------------ */

/**
 * One row per account per day — our own follower history.
 *
 * This table exists because the Graph API will not give us what the
 * dashboard needs:
 *   • `follower_count` insights only reach ~30 days back, with no backfill.
 *   • Unfollows are never exposed, in any form.
 * So we snapshot every day and derive the rest locally. Every day the
 * scheduler doesn't run is a day of history that cannot be recovered.
 */
model IgDailySnapshot {
  id          String   @id @default(cuid())
  igAccountId String
  date        DateTime @db.Date

  /**
   * Null on days reconstructed from insights alone. The profile endpoint
   * only ever reports *now*, so a day we didn't observe has no honest
   * follower total — and inventing one would make the derived unfollow
   * figure wrong rather than absent.
   */
  followersCount Int?
  followsCount   Int?
  mediaCount     Int?

  /** Gross new follows that day, from the `follower_count` insight. */
  newFollowers      Int?
  /**
   * Real unfollows for the day, from `follows_and_unfollows` broken down by
   * follow_type (NON_FOLLOWER). Measured by Meta — not the older
   * (gained - net) estimate, which was only used before this metric was found.
   */
  unfollows         Int?
  reach             Int?
  /** `views` — Meta removed `impressions` for Instagram in v22. */
  views             Int?
  profileViews      Int?
  accountsEngaged   Int?
  totalInteractions Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([igAccountId, date])
  @@index([igAccountId, date])
  /* --- Account-wide daily totals, all measured by Meta -------------------
     Confirmed available on this account by probing the API one metric at a
     time; `impressions` is deliberately absent because Meta removed it. */
  websiteClicks     Int?
  likes             Int?
  comments          Int?
  shares            Int?
  saves             Int?
  /** Story replies. Account-wide, not per-story. */
  replies           Int?

}

/** Posts, reels and their insights. Upserted by IG media id. */
model IgMedia {
  id          String @id
  igAccountId String

  caption      String   @default("")
  mediaType    String
  /** FEED | REELS | STORY — decides which insight metrics are valid. */
  productType  String   @default("FEED")
  mediaUrl     String?
  thumbnailUrl String?
  permalink    String   @default("")
  timestamp    DateTime

  likeCount     Int @default(0)
  commentsCount Int @default(0)

  reach             Int?
  views             Int?
  saved             Int?
  shares            Int?
  totalInteractions Int?
  /** Reels only, in milliseconds. */
  avgWatchTimeMs    Int?

  syncedAt DateTime @updatedAt

  @@index([igAccountId, timestamp])
  /** FEED-only insights; Meta rejects these metrics for reels. */
  profileVisits Int?
  followsFromPost Int?

}

/* --------------------------- Deployment Center -------------------------- */

enum DeployState {
  READY
  BUILDING
  QUEUED
  ERROR
  CANCELED
}

enum DeployEnvironment {
  PRODUCTION
  PREVIEW
  DEVELOPMENT
}

enum ProviderName {
  GITHUB
  VERCEL
}

model Project {
  id             String            @id @default(cuid())
  name           String
  description    String            @default("")
  framework      String            @default("nextjs")
  environment    DeployEnvironment @default(PRODUCTION)
  /** GitHub */
  repoUrl        String            @default("")
  repoName       String            @default("")
  repoId         String?
  defaultBranch  String            @default("main")
  /** Vercel */
  vercelProject  String            @default("")
  vercelProjectId String?
  /** URLs */
  productionUrl  String            @default("")
  previewUrl     String            @default("")
  customDomain   String            @default("")
  notes          String            @default("")
  state          DeployState       @default(QUEUED)
  /** manual | github | vercel */
  source         String            @default("manual")
  lastDeployedAt DateTime?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  deployments Deployment[]
  envVars     ProjectEnvVar[]
  syncs       SyncHistory[]

  @@unique([repoName, vercelProject])
  @@index([state])
  @@index([repoName])
}

model Deployment {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number        Int
  /** Provider deployment id (e.g. Vercel dpl_…) */
  externalId    String?
  state         DeployState       @default(QUEUED)
  environment   DeployEnvironment @default(PRODUCTION)
  branch        String            @default("main")
  commitSha     String            @default("")
  commitMessage String            @default("")
  commitAuthor  String            @default("")
  url           String?
  durationMs    Int?
  createdAt     DateTime          @default(now())
  finishedAt    DateTime?

  logs DeploymentLog[]

  @@unique([projectId, number])
  @@index([projectId, createdAt])
  @@index([externalId])
}

model DeploymentLog {
  id           String     @id @default(cuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  level        String     @default("info")
  message      String
  at           DateTime   @default(now())

  @@index([deploymentId, at])
}

/** Per-project environment variables — value is encrypted at rest. */
model ProjectEnvVar {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key            String
  valueEncrypted String
  environment    DeployEnvironment @default(PRODUCTION)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([projectId, key, environment])
}

/** GitHub / Vercel account connection + encrypted credentials. */
model ProviderConnection {
  id                  String            @id @default(cuid())
  provider            ProviderName      @unique
  status              IntegrationStatus @default(NOT_CONNECTED)
  /** AES-256-GCM blob — never leaves the server. */
  credentialsEncrypted String?
  scopes              String[]
  webhookActive       Boolean           @default(false)
  oauthAuthorized     Boolean           @default(false)
  lastSyncAt          DateTime?
  lastError           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

/** Raw webhook envelope — kept for replay protection and debugging. */
model WebhookEvent {
  id         String       @id @default(cuid())
  provider   ProviderName
  eventType  String
  externalId String?
  signature  String?
  verified   Boolean      @default(false)
  processed  Boolean      @default(false)
  payload    Json
  error      String?
  receivedAt DateTime     @default(now())

  @@index([provider, receivedAt])
  @@unique([provider, externalId])
}

model SyncHistory {
  id          String       @id @default(cuid())
  provider    ProviderName
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  trigger     String       @default("scheduler")
  success     Boolean      @default(false)
  recordCount Int          @default(0)
  durationMs  Int?
  error       String?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?

  @@index([provider, startedAt])
}

/* ------------------------- Notifications & audit ----------------------- */

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  tone      NotificationTone @default(INFO)
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/* ----------------------------- Landing Pages ------------------------------ */

enum LandingPageSource {
  VERCEL
  MANUAL
}

enum LandingPageStatus {
  LIVE
  BUILDING
  QUEUED
  FAILED
  CANCELED
  UNKNOWN
}

/**
 * A landing page the team chose to track.
 *
 * Deliberately NOT the same table as Project: the Deployment Center mirrors
 * everything a provider reports, whereas this list is hand-picked and must
 * never grow on its own. Keeping them apart is what stops a Vercel sync from
 * silently populating the client-facing screen.
 *
 * Vercel stays the source of truth for deployment state. Only the reference
 * and a cached copy of the last known state live here, so the dashboard can
 * render instantly and survive a Vercel outage. No credential is ever stored
 * on this row.
 */
model LandingPage {
  id     String            @id @default(cuid())
  name   String
  source LandingPageSource @default(VERCEL)

  /** Null for manually added pages. Unique so re-importing is idempotent. */
  vercelProjectId String? @unique
  /** Vercel's own project name, shown so the client can find it in Vercel. */
  vercelProjectName String @default("")

  productionUrl String  @default("")
  previewUrl    String  @default("")
  deploymentId  String?

  status      LandingPageStatus @default(UNKNOWN)
  framework   String            @default("")
  environment String            @default("production")
  description String            @default("")

  lastDeploymentAt DateTime?
  lastSyncedAt     DateTime?

  /**
   * Every row in this table is by definition selected — the column exists
   * because the spec calls for it, and it allows hiding a page without
   * losing its history.
   */
  isSelected Boolean @default(true)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isSelected, createdAt])
}


/**
 * A story, captured while its insights still exist.
 *
 * Stories disappear after 24 hours and their insights go with them, so this
 * table is the only lasting record — a missed sync is a permanent gap, the
 * same way it is for follower history.
 */
model IgStory {
  id           String   @id
  igAccountId  String
  mediaType    String   @default("IMAGE")
  permalink    String   @default("")
  timestamp    DateTime
  reach        Int?
  views        Int?
  replies      Int?
  navigation   Int?
  totalInteractions Int?
  capturedAt   DateTime @default(now())

  @@index([igAccountId, timestamp])
}
