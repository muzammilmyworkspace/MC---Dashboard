{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "noUnusedLocals": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // Tests are type-checked by tsconfig.test.json; keeping them out here stops
  // them being emitted into dist/ alongside the shipped server.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
