# ---------------------------------------------------------------------------
# MC Nexus — Mission Control API
# Copy to `.env` and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml
DATABASE_URL="postgresql://nexus:nexus@localhost:5432/mc_nexus?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3002
# COOKIE_DOMAIN=.maincharacter.nl

# Seed password for the three demo accounts
SEED_PASSWORD="MainCharacter#2026"

# --- Credential encryption (REQUIRED in production) ------------------------
# 32 bytes as 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Provider credentials are stored AES-256-GCM encrypted with this key.
ENCRYPTION_KEY=

# --- Deployment Center: GitHub --------------------------------------------
# GITHUB_TOKEN=                 # fine-grained PAT with repo + webhook access
# GITHUB_CLIENT_ID=             # only for sign-in-with-GitHub
# GITHUB_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=        # verifies X-Hub-Signature-256
GITHUB_API_URL=https://api.github.com

# --- Deployment Center: Vercel --------------------------------------------
# VERCEL_TOKEN=                 # Account Settings → Tokens (read access is enough)
# VERCEL_TEAM_ID=               # blank for a personal account
# VERCEL_PROJECT_ID=
# VERCEL_WEBHOOK_SECRET=        # verifies x-vercel-signature
VERCEL_API_URL=https://api.vercel.com

# Webhooks are the primary sync path. Set a value (>= 15000 ms) to also poll
# as a fallback where webhooks can't reach this API. 0 disables polling.
DEPLOY_SYNC_INTERVAL_MS=0
DEPLOY_CACHE_TTL_MS=60000

# --- Email (optional — mail is a no-op when unset) -------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="MC Nexus <no-reply@maincharacter.nl>"

# --- Phase 2 integrations (fill in as each API is enabled) -----------------
OAUTH_REDIRECT_BASE=http://localhost:4000/api/integrations/callback

# ===========================================================================
# Meta / Instagram / Facebook
# ===========================================================================
# EVERY value below is server-side only. None of them may be copied into the
# Next.js app's .env.local, and none may ever carry a NEXT_PUBLIC_ prefix —
# Next.js inlines those into the browser bundle, which would publish the
# secret to anyone who opens devtools.
#
# All are optional at boot. The dashboard runs fine without them; the
# Instagram integration reports "Instagram integration is not configured."
# until they are filled in. See src/services/integrations/meta-config.ts.

# --- Meta app identity ------------------------------------------------------
# developers.facebook.com → your app → App settings → Basic.
# META_APP_ID=
# META_APP_SECRET=

# --- OAuth: Facebook Login for Business ------------------------------------
# Configuration "MC Nexus Instagram". This one is public (it appears in the
# authorization URL), so it is safe to keep in the committed template.
META_INSTAGRAM_CONFIG_ID=1038676265802072

# Must match a redirect URI registered on the Meta app BYTE FOR BYTE —
# trailing slashes and http/https included, or Meta rejects the callback.
# Follows this project's existing convention:
#   OAUTH_REDIRECT_BASE + "/" + <provider key>
# In production, change to the deployed API's public URL (not the Vercel
# frontend URL — the callback is handled by this Express server).
# META_REDIRECT_URI=http://localhost:4000/api/integrations/callback/meta

# --- Webhooks (not implemented yet) ----------------------------------------
# A value you invent, echoed back to Meta during the subscription handshake.
# Generate with:  openssl rand -hex 32
# META_WEBHOOK_VERIFY_TOKEN=

# --- Direct read access (System User token path) ---------------------------
# Used by the existing Instagram stats sync, which does not go through OAuth.
# Business Settings → Users → System Users → Generate Token, expiry "Never".
# META_ACCESS_TOKEN=
# META_BUSINESS_ID=
# FB_PAGE_ID=
# Find this with GET /api/instagram/diagnostics once the token is set.
# IG_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v23.0

# Snapshot cadence. Followers/unfollows are built from these snapshots and
# cannot be backfilled, so leave this on in production. 0 disables.
IG_SYNC_INTERVAL_MS=21600000
IG_MEDIA_LIMIT=50

# Google Ads
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Google Analytics 4 / Search Console / Workspace
# GA4_PROPERTY_ID=
# GSC_SITE_URL=
# WORKSPACE_ADMIN_EMAIL=
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# YouTube
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# LinkedIn
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ORG_URN=

# TikTok
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=

# Storage
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=

# AI
# OPENAI_API_KEY=
